<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>org.example</groupId>
  <artifactId>lab2</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>war</packaging>

  <name>lab2 Maven Webapp</name>
  <url>http://www.example.com</url>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>1.7</maven.compiler.source>
    <maven.compiler.target>1.7</maven.compiler.target>
  </properties>

  <dependencies>

    <!--
    Зависимость JUnit используется для модульного тестирования проекта.
    Область действия test означает, что библиотека используется только
    при компиляции и выполнении тестов.
    -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.11</version>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>

    <!-- Имя итогового WAR-файла -->
    <finalName>lab2</finalName>

    <pluginManagement>
      <plugins>

        <!--
        maven-clean-plugin удаляет файлы и каталоги,
        созданные во время предыдущей сборки проекта.
        Основная команда плагина: clean.
        -->
        <plugin>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.1.0</version>
        </plugin>

        <!--
        maven-resources-plugin копирует ресурсы проекта
        в каталог target во время сборки.
        -->
        <plugin>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.0.2</version>
        </plugin>

        <!--
        maven-compiler-plugin выполняет компиляцию
        исходного Java-кода и тестовых классов.
        -->
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.8.0</version>
        </plugin>

        <!--
        maven-surefire-plugin запускает модульные тесты
        и формирует отчеты о результатах тестирования.
        -->
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>2.22.1</version>
        </plugin>

        <!--
        maven-war-plugin формирует WAR-архив web-приложения,
        содержащий классы, ресурсы и другие компоненты проекта.
        -->
        <plugin>
          <artifactId>maven-war-plugin</artifactId>
          <version>3.2.2</version>
        </plugin>

        <!--
        maven-install-plugin устанавливает созданный артефакт
        проекта в локальный репозиторий Maven.
        -->
        <plugin>
          <artifactId>maven-install-plugin</artifactId>
          <version>2.5.2</version>
        </plugin>

        <!--
        maven-deploy-plugin используется для размещения
        созданного артефакта в удаленном репозитории.
        -->
        <plugin>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>2.8.2</version>
        </plugin>

      </plugins>
    </pluginManagement>

  </build>

</project>